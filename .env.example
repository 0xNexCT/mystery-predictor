# Vercel KV (Upstash Redis)
# Create a KV store at https://vercel.com/dashboard/stores
KV_URL=
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=

# Public site URL (used for share cards / X intent links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin secret — protects /api/admin/resolve (used to mark question answers
# once the real-world event resolves). Set the same value in Vercel env.
# Generate one with: openssl rand -hex 32
ADMIN_SECRET=
